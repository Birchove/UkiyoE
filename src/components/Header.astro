---
import { CATEGORIES, CATEGORY_KEYS } from '../lib/categories';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';

const navItems = [
  { href: '/', label: '首页' },
  ...CATEGORY_KEYS.map((k) => ({ href: `/${k}`, label: CATEGORIES[k].label })),
  { href: '/about', label: '关于' },
];

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---
<header class={`site-header${isHome ? ' is-home' : ''}`}>
  <div class="nav-inner">
    <a href="/" class="brand" aria-label="浮世微言 · 首页">
      <img class="brand-mark" src="/logo.png" alt="浮世微言 印" width="42" height="42" />
      <span class="brand-text">
        <span class="brand-cn">浮世微言</span>
        <span class="brand-en">UkiyoE · 现代民间史</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
